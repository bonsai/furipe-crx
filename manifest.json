{
  "manifest_version": 3,
  "name": "FURIPE Scout",
  "version": "0.1.0",
  "description": "今見ているページや選択文字から、日本のフリーペーパーをFURIPEで探すChrome拡張。",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "FURIPE Scout",
    "default_popup": "popup.html"
  },
  "host_permissions": ["https://furipe.net/*"]
}